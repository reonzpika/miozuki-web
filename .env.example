# Blog (Journal) — Storefront API handle must match the blog in Shopify admin (Online Store → Blog posts). URL paths stay /blogs/news.
# SHOPIFY_BLOG_HANDLE=news

# Copy this file to .env.local and fill in the values.
# Get values from Ryo — do not share these publicly.

# Shopify Storefront API — server-side
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Shopify Storefront API — client-side (public token)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Shopify Admin API
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Judge.me
JUDGE_ME_PRIVATE_TOKEN=

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REFRESH_SECRET=

# Klaviyo
KLAVIYO_PRIVATE_KEY=
KLAVIYO_LIST_ID=

# Resend (transactional email — copy-review submission endpoint)
RESEND_API_KEY=

# Image generation script (npm run gen-image)
LAOZHANG_API_KEY=

# Analytics (client-side, public). Both no-op if left blank.
# GA4 Measurement ID, format G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=
# Meta (Facebook) Pixel ID, a ~15-digit number
NEXT_PUBLIC_META_PIXEL_ID=

# Admin dashboard (/admin). Gated by a single shared password.
# ADMIN_PASSWORD: what Ryo/Ting type on the login screen.
# ADMIN_SESSION_SECRET: a long random string stored in the session cookie.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Vercel read token for the Home tab's deploy feed (optional; Home degrades
# gracefully without it). Token from Vercel account settings > Tokens.
# Project and team IDs are in .vercel/project.json.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Admin Analytics tab — GA4 Data API (server-side, read-only). The tab degrades
# to "not connected yet" without these. Needs a service account granted Viewer
# on the GA4 property, with the Google Analytics Data API enabled in its project.
# GA_PROPERTY_ID: numeric GA4 property id (the digits after "p" in the GA4 URL).
GA_PROPERTY_ID=
GA_SA_CLIENT_EMAIL=
# Paste the whole private key on one line with \n in place of newlines.
GA_SA_PRIVATE_KEY=
# Sales tiles ignore orders before this date (YYYY-MM-DD), so historical
# test-mode checkouts don't show. Leave blank to count everything.
SALES_START_DATE=2026-06-23

# Admin SEO tab — Search Console (server-side, read-only). Reuses the GA_SA_*
# service account above; that account must be a user on the Search Console
# property and have the Search Console API enabled in its GCP project.
# GSC_SITE_URL: the property exactly as it appears in Search Console.
GSC_SITE_URL=sc-domain:miozuki.co.nz
